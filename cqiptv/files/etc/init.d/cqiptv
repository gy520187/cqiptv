#!/bin/sh /etc/rc.common
# Copyright 2026 cqiptv
# IPTV collector: Web 服务（Flask）+ 可选定时采集（scheduler）
START=99
STOP=10
USE_PROCD=1

APP_DIR=/usr/share/cqiptv
WORK_DIR=/etc/cqiptv
PYTHON=/usr/bin/python3

# 自动检测本机 LAN IPv4（OpenWrt 优先 ubus 查 br-lan，回退 ip 命令）
detect_lan_ip() {
    local ip
    ip=$(ubus call network.interface.lan status 2>/dev/null | awk -F'"' '/"address"/{print $4; exit}')
    [ -n "$ip" ] && { echo "$ip"; return; }
    ip=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    [ -n "$ip" ] && { echo "$ip"; return; }
    echo "192.168.1.1"
}

# 迁移旧版数据：procd 的 cwd 参数在部分固件不生效，旧数据落在 /app 下。
# 仅移动 cqiptv 明确产生的路径，不影响其他应用；目标目录已存在且有内容则不迁移。
migrate_legacy() {
    local legacy="/app"
    [ -d "$legacy/output" ] || [ -f "$legacy/config.yaml" ] || return 0
    local target_empty
    if [ ! -d "$WORK_DIR/output" ] || [ -z "$(ls -A "$WORK_DIR/output" 2>/dev/null)" ]; then
        mv "$legacy/output" "$WORK_DIR/output" 2>/dev/null || true
    fi
    if [ -f "$legacy/config.yaml" ] && [ ! -f "$WORK_DIR/config.yaml" ]; then
        mv "$legacy/config.yaml" "$WORK_DIR/config.yaml" 2>/dev/null || true
    fi
    if [ -f "$legacy/config.example.yaml" ] && [ ! -f "$WORK_DIR/config.example.yaml" ]; then
        mv "$legacy/config.example.yaml" "$WORK_DIR/config.example.yaml" 2>/dev/null || true
    fi
    if [ ! -d "$WORK_DIR/log" ] || [ -z "$(ls -A "$WORK_DIR/log" 2>/dev/null)" ]; then
        mv "$legacy/log" "$WORK_DIR/log" 2>/dev/null || true
    fi
    if [ -d "$legacy/data/epg_cache" ] && { [ ! -d "$WORK_DIR/data/epg_cache" ] || [ -z "$(ls -A "$WORK_DIR/data/epg_cache" 2>/dev/null)" ]; }; then
        mkdir -p "$WORK_DIR/data"
        mv "$legacy/data/epg_cache" "$WORK_DIR/data/epg_cache" 2>/dev/null || true
    fi
    if [ -d "$legacy/data/icon" ] && { [ ! -d "$WORK_DIR/data/icon" ] || [ -z "$(ls -A "$WORK_DIR/data/icon" 2>/dev/null)" ]; }; then
        mkdir -p "$WORK_DIR/data"
        mv "$legacy/data/icon" "$WORK_DIR/data/icon" 2>/dev/null || true
    fi
}

start_service() {
    # 准备运行时工作目录
    [ -d "$WORK_DIR" ] || mkdir -p "$WORK_DIR"
    # 迁移旧版（procd cwd 不生效时数据落在 /app 下）到标准运行时目录。
    # 仅移动 cqiptv 明确产生的路径，避免影响其他应用；目标已存在或有内容则不迁移。
    migrate_legacy
    [ -d "$WORK_DIR/data" ] || mkdir -p "$WORK_DIR/data"
    [ -d "$WORK_DIR/data/icon" ] || mkdir -p "$WORK_DIR/data/icon"
    [ -d "$WORK_DIR/output" ] || mkdir -p "$WORK_DIR/output"
    [ -d "$WORK_DIR/log" ] || mkdir -p "$WORK_DIR/log"
    if [ ! -f "$WORK_DIR/config.example.yaml" ]; then
        cp "$APP_DIR/config.example.yaml" "$WORK_DIR/" 2>/dev/null || true
    fi
    # 内置频道图标首次启动复制到运行时数据目录（不覆盖已有图标）
    if [ -d "$APP_DIR/data/icon" ]; then
        cp -n "$APP_DIR/data/icon/"*.png "$WORK_DIR/data/icon/" 2>/dev/null || true
    fi

    # 从 UCI 读取配置
    config_load 'cqiptv'
    local port web_auth icon_host epg_url epg_workers
    local sched_enabled cron
    config_get port 'web' 'port' '6061'
    config_get web_auth 'web' 'auth' ''
    config_get icon_host 'web' 'icon_host' ''
    if [ -z "$icon_host" ] || [ "$icon_host" = "http://192.168.1.1:6061" ]; then
        icon_host="http://$(detect_lan_ip):$port"
    fi
    config_get epg_url 'web' 'epg_url' ''
    config_get epg_workers 'web' 'epg_workers' '2'
    config_get cron 'scheduler' 'cron' '0 4 * * *'

    # APScheduler / tzlocal / blinker 不在 OpenWrt 官方源，已捆绑到 vendor
    # 注意：必须用 procd_set_param env 传给子进程，仅 export 不会进入 procd 环境
    procd_open_instance
    procd_set_param command "$PYTHON" "$APP_DIR/server.py"
    procd_set_param cwd "$WORK_DIR"
    procd_set_param env PYTHONPATH="$APP_DIR/vendor" CQIPTV_BASE_DIR="$WORK_DIR" WEB_PORT="$port" WEB_AUTH="$web_auth" ICON_HOST="$icon_host" EPG_URL="$epg_url" EPG_WORKERS="$epg_workers" TZ='Asia/Shanghai'
    procd_set_param file "$WORK_DIR/config.yaml"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # 定时任务进程始终启动：是否调度由 config.yaml 中的定时任务配置决定
    # （Web「定时任务」页保存后自动生效，不再依赖 UCI enabled 开关）
    procd_open_instance
    procd_set_param command "$PYTHON" "$APP_DIR/scheduler.py"
    procd_set_param cwd "$WORK_DIR"
    procd_set_param env PYTHONPATH="$APP_DIR/vendor" CQIPTV_BASE_DIR="$WORK_DIR" SCHEDULER_ENABLED=1 SCHEDULER_CRON="$cron" WEB_PORT="$port" WEB_AUTH="$web_auth" ICON_HOST="$icon_host" EPG_URL="$epg_url" EPG_WORKERS="$epg_workers" TZ='Asia/Shanghai'
    procd_set_param file "$WORK_DIR/config.yaml"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_kill 'cqiptv' 2>/dev/null || true
}