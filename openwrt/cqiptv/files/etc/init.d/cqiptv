#!/bin/sh /etc/rc.common
# Copyright 2026 cqiptv
# IPTV collector: Web 服务（Flask）+ 可选定时采集（scheduler）
START=99
STOP=10
USE_PROCD=1

APP_DIR=/usr/share/cqiptv
WORK_DIR=/etc/cqiptv
PYTHON=/usr/bin/python3

start_service() {
    # 准备运行时工作目录
    [ -d "$WORK_DIR" ] || mkdir -p "$WORK_DIR"
    [ -d "$WORK_DIR/data" ] || mkdir -p "$WORK_DIR/data"
    [ -d "$WORK_DIR/output" ] || mkdir -p "$WORK_DIR/output"
    [ -d "$WORK_DIR/log" ] || mkdir -p "$WORK_DIR/log"
    if [ ! -f "$WORK_DIR/config.example.yaml" ]; then
        cp "$APP_DIR/config.example.yaml" "$WORK_DIR/" 2>/dev/null || true
    fi

    # 从 UCI 读取配置
    config_load 'cqiptv'
    local port web_auth icon_host epg_url epg_workers
    local sched_enabled cron
    config_get port 'web' 'port' '6061'
    config_get web_auth 'web' 'auth' ''
    config_get icon_host 'web' 'icon_host' 'http://192.168.1.1:6061'
    config_get epg_url 'web' 'epg_url' ''
    config_get epg_workers 'web' 'epg_workers' '2'
    config_get sched_enabled 'scheduler' 'enabled' '0'
    config_get cron 'scheduler' 'cron' '0 4 * * *'

    # APScheduler / tzlocal / blinker 不在 OpenWrt 官方源，已捆绑到 vendor
    # 注意：必须用 procd_set_param env 传给子进程，仅 export 不会进入 procd 环境
    procd_open_instance
    procd_set_param command "$PYTHON" "$APP_DIR/server.py"
    procd_set_param env PYTHONPATH="$APP_DIR/vendor" WEB_PORT="$port" WEB_AUTH="$web_auth" ICON_HOST="$icon_host" EPG_URL="$epg_url" EPG_WORKERS="$epg_workers" TZ='Asia/Shanghai'
    procd_set_param file "$WORK_DIR/config.yaml"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    if [ "$sched_enabled" = "1" ]; then
        procd_open_instance
        procd_set_param command "$PYTHON" "$APP_DIR/scheduler.py"
        procd_set_param env PYTHONPATH="$APP_DIR/vendor" SCHEDULER_ENABLED=1 SCHEDULER_CRON="$cron" WEB_PORT="$port" WEB_AUTH="$web_auth" ICON_HOST="$icon_host" EPG_URL="$epg_url" EPG_WORKERS="$epg_workers" TZ='Asia/Shanghai'
        procd_set_param file "$WORK_DIR/config.yaml"
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
}

stop_service() {
    procd_kill 'cqiptv' 2>/dev/null || true
}