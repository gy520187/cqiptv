# Docker Compose 环境变量（复制为 .env 后生效）
TZ=Asia/Shanghai

# 宿主机映射端口（与容器内一致；6000 被浏览器列入禁用端口，故默认 6060）
WEB_PORT=6060

# 图标服务器地址（会被 M3U 引用）
# 注意：这是第三方播放器能访问到的地址，例如局域网 IP
ICON_HOST=http://192.168.1.100:6060

# M3U 头部 x-tvg-url 指向的节目单地址（可选）
# 留空默认 ICON_HOST/epg.xml.gz；播放器走独立 EPG 入口时在此填写完整地址
#EPG_URL=

# 外网访问 Web 界面的鉴权（可选），格式 user:password，留空不启用
# 外网暴露时强烈建议设置
WEB_AUTH=

# EPG 并行采集线程数（可选），0/1 表示串行，默认 4
# 并发越高采集越快，但会增加运营商接口请求频率，请按需调整
#EPG_WORKERS=4